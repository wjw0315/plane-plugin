{
  "name": "openchamber-plane",
  "version": "0.10.0",
  "private": true,
  "description": "Plane 任务看板 —— OpenChamber guest 扩展",
  "type": "module",
  "scripts": {
    "build": "npm run build:panel && npm run build:service",
    "build:panel": "esbuild panel/src/main.js --bundle --format=iife --platform=browser --target=es2020 --outfile=panel/main.js",
    "build:service": "esbuild service/src/main.js --bundle --format=cjs --platform=node --target=node20 --outfile=service/main.cjs",
    "test": "node test/smoke.mjs"
  },
  "devDependencies": {
    "@openchamber/sdk": "2.7.2",
    "esbuild": "^0.28.2"
  },
  "openchamber": {
    "apiVersion": 1,
    "engines": {
      "openchamber": ">=2.7.0"
    },
    "id": "openchamber-plane",
    "name": "Plane",
    "icon": "layout-columns",
    "contributes": {
      "panel": {
        "id": "openchamber-plane",
        "name": "Plane",
        "icon": "layout-columns",
        "entry": "panel/index.html",
        "mobile": true
      },
      "service": {
        "entry": "service/main.cjs",
        "runtime": "host"
      },
      "capabilities": [
        "sessions",
        "prompt"
      ],
      "sessionControl": {
        "content": true
      },
      "sessionEvents": {
        "events": [
          "turn-finished"
        ],
        "content": true
      },
      "commands": [
        {
          "name": "plane",
          "description": "Plane 工作项：/plane XLMSC-24 挂成会话 chip"
        }
      ],
      "links": {
        "action": "open",
        "identifier": {
          "keys": [
            "XLMSC"
          ]
        }
      },
      "actions": [
        {
          "id": "plane-bind",
          "label": "Plane：挂到工作项",
          "where": "session"
        }
      ]
    }
  }
}
